#!/usr/bin/env bash
# One command: start Postgres, build if needed, run the Skewer CLI.
#   ./skewer demo        reproduce the double-spend
#   ./skewer matrix      run every experiment and write docs/report/index.html
set -euo pipefail
cd "$(dirname "$0")"
docker compose up -d --wait >/dev/null
JAR=experiments/target/skewer.jar
if [ ! -f "$JAR" ] || [ -n "$(find . -name '*.java' -newer "$JAR" -not -path '*/target/*' -print -quit)" ]; then
  echo "building..."
  ./mvnw -q -B -DskipTests install
fi
exec java -Dstdout.encoding=UTF-8 -jar "$JAR" "$@"
